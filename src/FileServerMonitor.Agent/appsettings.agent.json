{
  "agentId": "fs01-agent",
  "server": "FS01",
  "apiBaseUrl": "http://localhost:8080",
  "apiRequestTimeoutSeconds": 120,
  "apiBatchSize": 500,
  "apiKey": "",
  "pollIntervalSeconds": 15,
  "batchSize": 200,
  "queueFlushBatchesPerCycle": 10,
  "queueFlushMaxEventsPerCycle": 10000,
  "enableSecurityLogCollector": true,
  "enableUsnJournalCollector": false,
  "enableCorrelation": true,
