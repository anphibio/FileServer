  "usnJournalScriptPath": "scripts/Collect-UsnJournalEvents.ps1",
  "securityLogTimeoutSeconds": 60,
  "usnJournalTimeoutSeconds": 120,
  "defaultShare": "FileServer",
  "eventIds": [4663, 4660, 4670],
