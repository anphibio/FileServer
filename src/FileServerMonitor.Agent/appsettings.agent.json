    "enabled": false,
    "intervalHours": 24,
    "batchSize": 500,
    "maxItemsPerScan": 0,
    "includeLastAccessTime": false,
    "windowStartLocal": "01:00",
    "windowEndLocal": "05:00",
    "roots": [
      {
        "path": "C:\\Corporativo",
        "server": "FileServer",
        "share": "Corporativo"
      }
    ]
  }
